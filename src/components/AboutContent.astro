---
import { Picture } from 'astro:assets';
import aboutImage from '../assets/general/about-image.jpg';
import Footer from './Footer.astro';

const today = new Date();
const pageUpperText = 
	`Hey! I'm Andreas, and this is where I blog my adventures, give travel tips (particularly for budget backpacking), and write 
	articles about wildlife, nature and sustainable products I've tried.`;
const pageUpperText2 = 
	`Right now I'm just starting out, so there aren't many posts up yet, but I've got tons of plans and am making content every day.`;
const pageText = 
	`Soon you'll be able to find even more stuff on my TikTok, where I'll be posting mini wildlife documentaries and videos about animals, as well as travel tips and ideas.`;
const pageText2 = 
	`I've got a YouTube channel too, but right now I'm not making separate videos for that, so it'll mostly just be TikTok reposts and shorts.`;
---

<style>	
	.about-article {
		max-width: 800px;
		margin: 0 auto;
	}

	.page-text {
		text-align: center;
		max-width: 600px;
		margin: 0 auto 2rem;
		font-size: 1.125rem;
		line-height: 1.6;
		color: #666;
		padding: 0 1rem;
	}

	.image-container {
		display: flex;
		justify-content: center;
		margin: 2rem 0;
		width: 100%;
	}

	.centered-image {
		width: 100%;
		max-width: 500px;
		height: auto;
		border-radius: 0px;
		display: block;
	}
		
	.image-container picture {
		display: flex;
		justify-content: center;
		width: 50%; /* This is where you control the size of the image relative to the page */
		min-width: 300px; /* Stops it getting too small on mobile */
	}
</style>

<article class="about-article">
	<p class="page-text">{pageUpperText}</p>
	<p class="page-text">{pageUpperText2}</p>

	<div class="image-container">
		<Picture 
			src={aboutImage} 
			alt="A picture of the website's author, Andreas, leaning against a low stone wall in Italy" 
			widths={[320, 500, 768]} 
			sizes="(max-width: 768px) 90vw, 500px"
			formats={['avif', 'webp']}
			fallbackFormat="jpg"
			class="centered-image"
		/>
	</div>

	<p class="page-text">{pageText}</p>
	<p class="page-text">{pageText2}</p>
</article>


<Footer />