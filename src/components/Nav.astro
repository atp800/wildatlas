---
import { Image } from 'astro:assets';
import atlasLogo from '../assets/general/atlas.png';

// Logic to check if we are on the homepage
const pathname = new URL(Astro.url).pathname;
const isHome = pathname === '/' || pathname === '/index.html';
---

<!-- class:list dynamically adds the 'home-header' class ONLY if we are on the homepage -->
<header class:list={["site-header", { "home-header": isHome }]}>
    
    <div class="logo">
        <a href="/">
            <Image 
            src={atlasLogo} 
            alt="Wild Atlas Logo" 
            height={400}
            format="png"
            quality="max"
            loading="eager" 
            class="logo-img" />
        </a>
    </div>

    <button class="menu-icon" aria-label="Menu">☰</button>

    <nav class="top-right-nav">
        <!-- The link only renders if we are NOT on the homepage -->
        {!isHome && <a href="/">HOME</a>}
        <a href="/travel">TRAVEL</a> 
        <a href="/nature">NATURE</a> 
        <a href="/eco">ECO</a> 
        <a href="/store">STORE</a> <!-- Added Store Link -->

        <!-- Cart Link with SVG Icon -->
        <a href="/cart" class="cart-link" aria-label="Shopping Cart">
            <svg 
              xmlns="http://www.w3.org/2000/svg" 
              width="26" 
              height="26" 
              viewBox="0 0 24 24" 
              fill="none" 
              stroke="currentColor" 
              stroke-width="2" 
              stroke-linecap="round" 
              stroke-linejoin="round"
              class="cart-icon"
            >
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            <span id="cart-badge" class="cart-badge">0</span>
        </a>
    </nav>
</header>

<style>
    /* STANDARD LAYOUT (For all pages except Homepage) */
    .site-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        box-sizing: border-box;
        padding: 20px 30px;
        color: #444; 
        z-index: 1000;
        position: relative;
    }

    /* HOMEPAGE LAYOUT */
    .home-header {
        position: absolute;
        top: 0;
        left: 0;
        color: white; 
    }

    .logo a {
        display: block;
    }

    .logo-img {
        height: 60px; 
        width: auto;
        display: block; 
        filter: brightness(0.2); 
    }
    .home-header .logo-img {
        filter: none;
    }

    .menu-icon {
        display: none;
        font-size: 30px;
        color: inherit;
        background: none;
        border: none;
        cursor: pointer;
        position: relative; 
        z-index: 1001; 
    }

    .top-right-nav {
        display: flex;
        gap: 40px;
        font-family: 'Urbanist', sans-serif;
        font-size: 20.5px;
        align-items: center;
        margin-top: -15px; 
    }

    .top-right-nav a {
        text-decoration: none;
        color: inherit; 
        transition: opacity 0.2s;
    }

    .top-right-nav a:hover {
        opacity: 0.5;
    }

    /* New Cart Link Styling */
    .cart-link {
        position: relative; /* This allows the badge to position itself relative to the icon */
        display: flex;
        align-items: center;
        padding-top: 5px; /* Aligns visually with text links */
    }

    .cart-icon {
        /* On standard pages, stroke inherits the dark grey. On home, it inherits white. */
        stroke: currentColor; 
    }

    .cart-badge {
        position: absolute;
        top: -5px;
        right: -10px;
        background-color: #444; /* Dark grey */
        color: white;
        font-size: 12px;
        min-width: 18px;
        height: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-weight: bold;
        display: none; /* Hidden by default */
        font-family: sans-serif;
    }
    
    .home-header .cart-badge {
        background-color: white;
        color: #111;
    }

    @media (max-width: 768px) {
        .site-header {
            padding: 20px 15px; 
        }

        .menu-icon {
            display: block; 
        }

        .top-right-nav {
            display: none;
            flex-direction: column;
            justify-content: flex-start;
            margin-top: 0; 
            position: fixed;
            top: 0; 
            right: 0;
            background-color: #111;
            width: 200px;
            height: 100vh;
            padding: 80px 20px;
            z-index: 999;
        }

        .top-right-nav.active {
            display: flex;
        }

        .top-right-nav a {
            color: white; 
            font-size: 24px;
        }
        
        /* Adjust cart for mobile menu */
        .cart-link {
            width: max-content;
        }

        .cart-badge {
            background-color: white;
            color: #111;
        }
    }  
</style>

<script>
    import { cart } from '../store/cart.ts';

    const initNav = () => {
        const menuIcon = document.querySelector('.menu-icon');
        const nav = document.querySelector('.top-right-nav');

        if (menuIcon && nav) {
            menuIcon.onclick = () => {
                nav.classList.toggle('active');
            };
        }

        const cartBadge = document.getElementById('cart-badge');
        
        if (cartBadge) {
            cart.subscribe((cartItems) => {
                const totalItems = Object.values(cartItems).reduce(
                    (sum, item) => sum + item.quantity, 
                    0
                );

                cartBadge.innerText = totalItems.toString();
                
                if (totalItems > 0) {
                    cartBadge.style.display = 'flex'; // Uses flex to perfectly center the number
                } else {
                    cartBadge.style.display = 'none';
                }
            });
        }
    };

    initNav();
    document.addEventListener('astro:after-swap', initNav);
</script>