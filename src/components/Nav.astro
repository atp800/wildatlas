---
import { Image } from 'astro:assets';
import atlasLogo from '../assets/general/atlas.png';

// Logic to check if we are on the homepage
const pathname = new URL(Astro.url).pathname;
const isHome = pathname === '/' || pathname === '/index.html';
---

<!-- class:list dynamically adds the 'home-header' class ONLY if we are on the homepage -->
<header class:list={["site-header", { "home-header": isHome }]}>
    
    <div class="logo">
        <a href="/">
            <!-- Render at 100px (2x resolution) for crisp Retina displays, styled to 50px in CSS -->
            <Image src={atlasLogo} alt="Wild Atlas Logo" height={100} loading="eager" class="logo-img" />
        </a>
    </div>

    <button class="menu-icon" aria-label="Menu">☰</button>

    <nav class="top-right-nav">
        <!-- The link only renders if we are NOT on the homepage -->
        {!isHome && <a href="/">HOME</a>}
        <a href="/travel">TRAVEL</a> 
        <a href="/nature">NATURE</a> 
        <a href="/eco">ECO</a> 
    </nav>

</header>

<style>
    /* STANDARD LAYOUT (For all pages except Homepage) */
    .site-header {
        display: flex;
        justify-content: space-between; /* Pushes Logo to left, Nav to right */
        align-items: center;
        width: 100%;
        box-sizing: border-box;
        padding: 20px 30px; /* Consistent spacing everywhere */
        color: #444; /* Dark text for standard pages */
        z-index: 1000;
        position: relative;
    }

    /* HOMEPAGE LAYOUT (Overlays on top of the hero image) */
    .home-header {
        position: absolute;
        top: 0;
        left: 0;
        color: white; /* White text to stand out over the image */
    }

    .logo a {
        display: block;
    }

    /* Fixes the blurry logo & invisible bottom spacing */
    .logo-img {
        height: 50px; /* Forces the 100px image to visually display at 50px */
        width: auto;
        display: block; /* Removes the default inline gap that throws off vertical centering */
    }

    .menu-icon {
        display: none;
        font-size: 30px;
        color: inherit;
        background: none;
        border: none;
        cursor: pointer;
        
        /* ADD THIS: Allows z-index to work so the icon stays above the open menu */
        position: relative; 
        z-index: 1001; 
    }

    .top-right-nav {
        display: flex;
        gap: 40px;
        font-family: 'Urbanist', sans-serif;
        font-size: 20.5px;
        align-items: center;
        
        /* Optical nudge: pulls the text up just slightly to perfectly match the logo */
        margin-top: -15px; 
    }

    .top-right-nav a {
        text-decoration: none;
        color: inherit; /* Automatically takes white on homepage, dark grey on others */
        transition: opacity 0.2s;
    }

    .top-right-nav a:hover {
        opacity: 0.5;
    }

    @media (max-width: 768px) {
        .site-header {
            padding: 20px 15px; /* Slightly tighter spacing on mobile screens */
        }

        .menu-icon {
            display: block; 
        }

        .top-right-nav {
            display: none;
            flex-direction: column;
            justify-content: flex-start;
            margin-top: 0; /* Reset our optical nudge for mobile */
            position: fixed;
            top: 0; 
            right: 0;
            background-color: #111;
            width: 200px;
            height: 100vh;
            padding: 80px 20px;
            z-index: 999;
        }

        .top-right-nav.active {
            display: flex;
        }

        .top-right-nav a {
            color: white; 
            font-size: 24px;
        }
    }  
</style>

<script>
    const initMobileNav = () => {
        const menuIcon = document.querySelector('.menu-icon');
        const nav = document.querySelector('.top-right-nav');

        if (menuIcon && nav) {
            // Using .onclick prevents duplicate event listeners
            menuIcon.onclick = () => {
                nav.classList.toggle('active');
            };
        }
    };

    // 1. Run immediately on standard page loads
    initMobileNav();

    // 2. Re-run if you ever decide to enable Astro View Transitions later
    document.addEventListener('astro:after-swap', initMobileNav);
</script>