---
import BaseHead from '../components/BaseHead.astro';
import AboutContent from '../components/AboutContent.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import GTMBodyNoScript from '../components/GTMBodyNoScript.astro';
import { Image, getImage } from 'astro:assets';
import '../styles/global.css';

import atlasLogo from '../assets/general/atlas.png'; 
import heroImageFile from '../assets/general/homepage-image.jpg';

const optimisedHomepageImage = await getImage({ 
  src: heroImageFile, 
  format: 'webp',
  width: 1920 
});
---

<!doctype html>
<html lang="en">
<head>
  <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  <link rel="preload" as="image" href={optimisedHomepageImage.src} type="image/webp">

  <style>
    .hero-image {
      height: 100vh;
      background-position: center;
      background-repeat: no-repeat;
      background-size: cover;
      display: flex;
      flex-direction: column;
      filter: saturate(1.2);
      position: relative;
    }
    
    .hero-text {
      text-align: center;
      font-family: 'Nothing You Could Do', cursive;
      font-size: 7rem; /* Using rem for better scaling */
      color: white;
      font-weight: 400; 
      font-style: normal;
      letter-spacing: 2px;
      text-shadow: 0 2px 10px rgba(0,0,0,0.3);
      line-height: 1.1; 
    }

  .hero-break {
    display: none;
  }

    .top-right-nav {
      position: absolute;
      top: 20px;
      right: 30px;
      display: flex;
      gap: 40px;
      z-index: 500;
    }

    .top-right-nav a {
      text-decoration: none;
      color: white;
      font-family: 'Urbanist', sans-serif;
      font-weight: 400;
      letter-spacing: 1px;
    }

    .overlay {
      background-color: rgba(0, 0, 0, 0.15);
      flex-grow: 1;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .logo-container {
      position: absolute;
      top: 20px;
      left: 20px;
      z-index: 500;
    }

    .menu-icon {
      display: none;
      background: none;
      border: none;
      color: white;
      font-size: 2rem;
      position: absolute;
      top: 20px;
      right: 20px;
      z-index: 1000;
      cursor: pointer;
    }

    @media (max-width: 768px) {
      .menu-icon { display: block; }
      .top-right-nav {
        display: none; /* Logic handled by JS */
        flex-direction: column;
        position: fixed;
        top: 0; right: 0;
        background: rgba(0,0,0,0.95);
        width: 200px;
        height: 100vh;
        padding: 80px 20px;
      }
      .top-right-nav.active { display: flex; }
      .hero-text { font-size: 7rem; line-height: 1.1;}
      .hero-break { display: block; }
    }
    @media (max-width: 480px) {
      .hero-text { font-size: 4rem; }
      .hero-break { display: block; }
    }
  
    
    /* Utility class for JS */
    .hidden { display: none !important; }
  </style>
</head>
<body>
  <GTMBodyNoScript />
	
  <header class="hero-image" style={`background-image: url('${optimisedHomepageImage.src}');`}>
    <div class="logo-container">
      <a href="/">
        <Image src={atlasLogo} alt="Wild Atlas Logo" height={50} loading="eager" />
      </a>
    </div>

    <button class="menu-icon" aria-label="Menu">☰</button>

    <nav class="top-right-nav">
        <a href="/travel">TRAVEL</a> 
        <a href="/nature">NATURE</a> 
        <a href="/eco">ECO</a> 
    </nav>

    <div class="overlay">
      <h1 class="hero-text">
        Wild <br class="hero-break" /> Atlas
      </h1>
    </div>
  </header>

  <main>
    <AboutContent />
  </main>

  <script>
    const menuIcon = document.querySelector('.menu-icon');
    const nav = document.querySelector('.top-right-nav');

    menuIcon?.addEventListener('click', () => {
      nav?.classList.toggle('active');
    });
  </script>
</body>
</html>