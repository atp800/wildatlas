---
import BaseHead from '../components/BaseHead.astro';
import AboutContent from '../components/AboutContent.astro';
import Nav from '../components/Nav.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import GTMBodyNoScript from '../components/GTMBodyNoScript.astro';
import { Image, getImage } from 'astro:assets';
import '../styles/global.css';

import atlasLogo from '../assets/general/atlas.png'; 
import heroImageFile from '../assets/general/homepage-image.jpg';

const optimisedHomepageImage = await getImage({ 
  src: heroImageFile, 
  format: 'webp',
  width: 1920 
});
---

<!doctype html>
<html lang="en">
<head>
  <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  <link rel="preload" as="image" href={optimisedHomepageImage.src} type="image/webp">

  <style>
    .hero-image {
      height: 100vh;
      background-position: center;
      background-repeat: no-repeat;
      background-size: cover;
      display: flex;
      flex-direction: column;
      filter: saturate(1.2);
      position: relative;
      color: white; /* Forces the Nav component items to be white here */
    }
    
    .hero-text {
      text-align: center;
      font-family: 'Nothing You Could Do', cursive;
      font-size: clamp(4rem, 15vw, 8rem); /* Fluid typography: adjusts size automatically */
      color: white;
      font-weight: 400; 
      letter-spacing: 2px;
      text-shadow: 0 2px 10px rgba(0,0,0,0.3);
      line-height: 1.1;
      margin: 0;
    }

    .hero-break {
      display: none;
    }

    .overlay {
      background-color: rgba(0, 0, 0, 0.15);
      flex-grow: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    @media (max-width: 768px) {
      .hero-break {
        display: block;
      }
    }
  </style>
</head>
<body>
  <GTMBodyNoScript />
	
  <header class="hero-image" style={`background-image: url('${optimisedHomepageImage.src}');`}>
    
    <Nav />

    <div class="overlay">
      <h1 class="hero-text">
        Wild <br class="hero-break" /> Atlas
      </h1>
    </div>
  </header>

  <main>
    <AboutContent />
  </main>
</body>
</html>