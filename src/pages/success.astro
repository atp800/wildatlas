---
// success.astro
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Stripe from 'stripe';
import { getCollection } from 'astro:content';

---

<html lang="en">
  <head>
    <BaseHead title="Order Successful | Wild Atlas" description="Thank you for your purchase!" />
  </head>
  <body>
    <Nav />
    <main class="message-container">
      <div class="icon-wrapper success-icon">✓</div>

          <h1>Payment Successful! 🌊</h1>
          <p>Thank you for supporting Wild Atlas! We've sent a confirmation email with your order details.</p>
          <p>If you ordered any digital items, you'll receive links to download in your email shortly. Be sure to check your spam/junk folder if thsi doesn't come through.</p>
        </>


      <a href="/store" class="btn outline-btn mt-4">Return to Store</a>
    </main>

    <style is:global>
      .message-container {
        text-align: center;
        padding: 100px 20px;
        max-width: 650px;
        margin: 0 auto;
        font-family: 'Urbanist', sans-serif;
      }
      .icon-wrapper {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 40px;
        margin: 0 auto 20px;
        color: white;
      }
      .success-icon { background-color: #2e7d32; }
      h1 { color: #222939; margin-bottom: 15px; }
      p { color: #666; margin-bottom: 30px; line-height: 1.6; }
      
      /* New Download Styles */
      .downloads-card {
        background: #f8f9fa;
        border: 1px solid #eaeaea;
        border-radius: 12px;
        padding: 30px;
        margin: 40px 0;
        text-align: left;
      }
      .downloads-card h2 {
        margin-top: 0;
        color: #222939;
        margin-bottom: 5px;
      }
      .download-list {
        list-style: none;
        padding: 0;
        margin: 20px 0 0 0;
      }
      .download-list li {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 0;
        border-top: 1px solid #eaeaea;
      }
      .file-name {
        font-weight: 600;
        color: #333;
      }
      
      .shipping-notice {
        background: #eef5ff;
        color: #004085;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 30px;
        text-align: left;
      }
      .shipping-notice p {
        margin: 0;
        color: inherit;
      }

      .btn {
        display: inline-block;
        background: #222939;
        color: white;
        padding: 12px 30px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: bold;
        transition: background 0.2s;
        border: 2px solid #222939;
        cursor: pointer;
      }
      .btn:hover { background: #444; border-color: #444; color: white;}
      .download-btn { padding: 8px 20px; font-size: 14px; }
      .outline-btn { background: transparent; color: #222939; }
      .mt-4 { margin-top: 20px; }
    </style>

    <script>
      import { clearCart } from '../store/cart.ts';
      // Empty the cart, order is fulfilled!
      clearCart();
    </script>
  </body>
</html>