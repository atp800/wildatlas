---
// success.astro
export const prerender = false; // Required for reading URL parameters and fetching from Stripe

import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Stripe from 'stripe';
import { getCollection } from 'astro:content';

const sessionId = Astro.url.searchParams.get('session_id');

let digitalDownloads: {name: string, url: string}[] =[];
let hasPhysicalItems = false;
let orderValid = false;
let customerName = '';

if (sessionId) {
  try {
    const stripe = new Stripe(import.meta.env.STRIPE_SECRET_KEY, { apiVersion: '2023-10-16' });
    
    // Retrieve the session and expand line_items
    const session = await stripe.checkout.sessions.retrieve(sessionId, {
      expand: ['line_items']
    });

    if (session.payment_status === 'paid') {
      orderValid = true;
      customerName = session.customer_details?.name || '';
      
      const products = await getCollection('products');

      session.line_items?.data.forEach(item => {
        const matchedProduct = products.find(p => p.data.stripePriceId === item.price?.id);
        if (matchedProduct) {
          if (!matchedProduct.data.physical && matchedProduct.data.downloadURL) {
            digitalDownloads.push({
              name: matchedProduct.data.title,
              url: matchedProduct.data.downloadURL
            });
          } else if (matchedProduct.data.physical) {
            hasPhysicalItems = true;
          }
        }
      });
    }
  } catch (error) {
    console.error("Error retrieving Stripe session:", error);
  }
}
---

<html lang="en">
  <head>
    <BaseHead title="Order Successful | Wild Atlas" description="Thank you for your purchase!" />
  </head>
  <body>
    <Nav />
    <main class="message-container">
      <div class="icon-wrapper success-icon">✓</div>
      
      {orderValid ? (
        <>
          <h1>Payment Successful! 🌊</h1>
          <p>Thank you for supporting Wild Atlas, {customerName}. We've sent a confirmation email with your order details.</p>

          {/* <!-- Digital Downloads Section --> */}
          {digitalDownloads.length > 0 && (
            <div class="downloads-card">
              <h2>Your Digital Purchases</h2>
              <p>Your files are ready to download:</p>
              <ul class="download-list">
                {digitalDownloads.map(dl => (
                  <li>
                    <span class="file-name">{dl.name}</span>
                    {/* <!-- download attribute prompts the browser to save the file --> */}
                    <a href={dl.url} download class="btn download-btn">Download File</a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {/* <!-- Physical Items Notice Section --> */}
          {hasPhysicalItems && (
            <div class="shipping-notice">
              <p>📦 <strong>Items included:</strong> We're preparing your items for shipment. Keep an eye on your email for tracking details.</p>
            </div>
          )}
        </>
      ) : (
        <>
          <h1>Processing Order...</h1>
          <p>If you just made a payment, it might take a moment to confirm. Please check your email for the receipt!</p>
        </>
      )}

      <a href="/store" class="btn outline-btn mt-4">Return to Store</a>
    </main>

    <style is:global>
      .message-container {
        text-align: center;
        padding: 100px 20px;
        max-width: 650px;
        margin: 0 auto;
        font-family: 'Urbanist', sans-serif;
      }
      .icon-wrapper {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 40px;
        margin: 0 auto 20px;
        color: white;
      }
      .success-icon { background-color: #2e7d32; }
      h1 { color: #222939; margin-bottom: 15px; }
      p { color: #666; margin-bottom: 30px; line-height: 1.6; }
      
      /* New Download Styles */
      .downloads-card {
        background: #f8f9fa;
        border: 1px solid #eaeaea;
        border-radius: 12px;
        padding: 30px;
        margin: 40px 0;
        text-align: left;
      }
      .downloads-card h2 {
        margin-top: 0;
        color: #222939;
        margin-bottom: 5px;
      }
      .download-list {
        list-style: none;
        padding: 0;
        margin: 20px 0 0 0;
      }
      .download-list li {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 0;
        border-top: 1px solid #eaeaea;
      }
      .file-name {
        font-weight: 600;
        color: #333;
      }
      
      .shipping-notice {
        background: #eef5ff;
        color: #004085;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 30px;
        text-align: left;
      }
      .shipping-notice p {
        margin: 0;
        color: inherit;
      }

      .btn {
        display: inline-block;
        background: #222939;
        color: white;
        padding: 12px 30px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: bold;
        transition: background 0.2s;
        border: 2px solid #222939;
        cursor: pointer;
      }
      .btn:hover { background: #444; border-color: #444; color: white;}
      .download-btn { padding: 8px 20px; font-size: 14px; }
      .outline-btn { background: transparent; color: #222939; }
      .mt-4 { margin-top: 20px; }
    </style>

    <script>
      import { clearCart } from '../store/cart.ts';
      // Empty the cart, order is fulfilled!
      clearCart();
    </script>
  </body>
</html>