---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';

// Fetch all products from the markdown collection
const allProducts = await getCollection('products');
const liveProducts = allProducts.filter((p) => p.data.live === true);

// Extract unique categories and types from LIVE products only
const categories =['all', ...new Set(liveProducts.map((p) => p.data.category))];
const types =['all', ...new Set(liveProducts.map((p) => p.data.type))];
---


<html lang="en">
  <head>
    <BaseHead 
      title="Store | Wild Atlas" 
      description="30% of profits go to environmental charities." 
    />
  </head>
  <body>
    <Nav />

    <main class="store-container">
      <h1 class="store-title">Store</h1>

      <!-- FILTERS -->
      <div class="filters-container">
        <div class="filter-group">
          <span class="filter-label">Category:</span>
          <div class="filter-tabs" id="category-filters">
            {categories.map(category => (
              <button 
                class={`filter-btn ${category === 'all' ? 'active' : ''}`} 
                data-filter-type="category" 
                data-value={category}
              >
                {category.charAt(0).toUpperCase() + category.slice(1)}
              </button>
            ))}
          </div>
        </div>

        <div class="filter-group">
          <span class="filter-label">Type:</span>
          <div class="filter-tabs" id="type-filters">
            {types.map(type => (
              <button 
                class={`filter-btn ${type === 'all' ? 'active' : ''}`} 
                data-filter-type="type" 
                data-value={type}
              >
                {type.charAt(0).toUpperCase() + type.slice(1)}
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- PRODUCT GRID -->
      <div class="product-grid" id="product-grid">
        {liveProducts.map((product) => (
          <div 
            class="product-card" 
            data-category={product.data.category} 
            data-type={product.data.type}
          >
            {/* <!-- ✨ LINK TO PRODUCT PAGE ✨ --> */}
            <a href={`/product/${product.id}`} class="product-link">
              <div class="product-image-wrapper">
                <Image 
                  src={product.data.image} 
                  alt={product.data.title} 
                  width={600} 
                  height={600} 
                  class="product-img"
                />
                {!product.data.inStock && <span class="out-of-stock-badge">Out of Stock</span>}
              </div>
            </a>
            
            <div class="product-info">
              <span class="product-type">{product.data.type.toUpperCase()}</span>
              {/* <!-- ✨ LINK TITLE TO PRODUCT PAGE ✨ --> */}
              <a href={`/product/${product.id}`} class="product-title-link">
                <h2 class="product-title">{product.data.title}</h2>
              </a>
              <p class="product-price">${product.data.price.toFixed(2)}</p>
              
              <button 
                class="add-to-cart-btn" 
                disabled={!product.data.inStock}
                data-id={product.id}
                data-name={product.data.title}
                data-price-id={product.data.stripePriceId}
                data-price={product.data.price}
                data-image={product.data.image.src}
                data-physical={product.data.physical ? "true" : "false"}
              >
                {product.data.inStock ? 'Add to Cart' : 'Sold Out'}
              </button>
            </div>
          </div>
        ))}
      </div>
      
      <!-- Empty State (Hidden by default) -->
      <div id="no-products-msg" class="no-products" style="display: none;">
        No products match your selected filters.
      </div>

    </main>

    <style>
      .store-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 20px;
      }

      .store-title {
        text-align: center;
        font-family: 'Nothing You Could Do', cursive;
        font-size: 3em;
        margin-bottom: 40px;
        color: #222939;
      }

      /* Filter Styles */
      .filters-container {
        display: flex;
        flex-direction: column;
        gap: 20px;
        margin-bottom: 40px;
        padding-bottom: 30px;
        border-bottom: 1px solid #eaeaea;
      }

      .filter-group {
        display: flex;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
      }

      .filter-label {
        font-family: 'Urbanist', sans-serif;
        font-weight: bold;
        color: #666;
        min-width: 80px;
      }

      .filter-tabs {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
      }

      .filter-btn {
        background: transparent;
        border: 1px solid #ccc;
        padding: 6px 16px;
        border-radius: 20px;
        cursor: pointer;
        font-family: 'Urbanist', sans-serif;
        font-size: 16px;
        color: #444;
        transition: all 0.2s ease;
      }

      .filter-btn:hover {
        border-color: #444;
      }

      .filter-btn.active {
        background: #444;
        color: white;
        border-color: #444;
      }

      /* Grid Styles */
      .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 40px;
      }

      .product-card {
        display: flex;
        flex-direction: column;
        transition: opacity 0.3s ease;
      }

      .product-image-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        border-radius: 8px;
        background: #f4f4f4;
        margin-bottom: 15px;
      }

      .product-image-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .product-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
      }

      .product-card:hover .product-img {
        transform: scale(1.05);
      }

      .product-link, .product-title-link {
        text-decoration: none;
        color: inherit;
        display: block; /* Ensures the image wrapper is fully clickable */
      }

      .product-title-link:hover .product-title {
        text-decoration: underline;
      }

      .out-of-stock-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        background: rgba(0,0,0,0.7);
        color: white;
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 12px;
        font-family: 'Urbanist', sans-serif;
      }

      .product-info {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
      }

      .product-type {
        font-size: 12px;
        color: #888;
        letter-spacing: 1px;
      }

      .product-title {
        font-size: 20px;
        margin: 5px 0 10px 0;
        line-height: 1.3;
      }

      .product-price {
        font-weight: bold;
        font-size: 18px;
        margin-bottom: 15px;
      }

      .add-to-cart-btn {
        margin-top: auto;
        background: #222939;
        color: white;
        border: none;
        padding: 12px;
        border-radius: 4px;
        cursor: pointer;
        font-family: 'Urbanist', sans-serif;
        font-size: 16px;
        font-weight: bold;
        transition: background 0.2s;
      }

      .add-to-cart-btn:hover:not(:disabled) {
        background: #444;
      }

      .add-to-cart-btn:disabled {
        background: #ccc;
        cursor: not-allowed;
      }

      .no-products {
        text-align: center;
        padding: 50px;
        color: #666;
        font-style: italic;
      }
    </style>

<!-- CLIENT-SIDE SCRIPT FOR FILTERING & CART -->
    <script>
      import { addToCart } from '../store/cart.ts';

      function initStore() {
        // --- 1. FILTER LOGIC ---
        const filterBtns = document.querySelectorAll('.filter-btn');
        const productCards = document.querySelectorAll('.product-card') as NodeListOf<HTMLElement>;
        const noProductsMsg = document.getElementById('no-products-msg');
        
        // Grab specifically the Type buttons so we can show/hide them
        const typeBtns = document.querySelectorAll('.filter-btn[data-filter-type="type"]') as NodeListOf<HTMLElement>;

        let currentFilters = {
          category: 'all',
          type: 'all'
        };

        filterBtns.forEach(btn => {
          btn.addEventListener('click', (e) => {
            const target = e.currentTarget as HTMLElement;
            const filterType = target.dataset.filterType!;
            const filterValue = target.dataset.value!;

            // Update current active state dictionary
            currentFilters[filterType as keyof typeof currentFilters] = filterValue;

            // Update UI for buttons (remove active class from siblings, add to clicked)
            const siblings = document.querySelectorAll(`.filter-btn[data-filter-type="${filterType}"]`);
            siblings.forEach(s => s.classList.remove('active'));
            target.classList.add('active');

            // ✨ NEW LOGIC: Dynamic Type Visibility ✨
            if (filterType === 'category') {
              // 1. Figure out which types exist inside this specific category
              const validTypes = new Set(['all']);
              
              productCards.forEach(card => {
                if (filterValue === 'all' || card.dataset.category === filterValue) {
                  validTypes.add(card.dataset.type);
                }
              });

              // 2. Hide or show the Type buttons based on validTypes
              typeBtns.forEach(typeBtn => {
                const btnTypeValue = typeBtn.dataset.value!;
                if (validTypes.has(btnTypeValue)) {
                  typeBtn.style.display = 'inline-block'; // Show it
                } else {
                  typeBtn.style.display = 'none'; // Hide it
                }
              });

              // 3. UX FIX: If their currently selected Type doesn't exist in the new Category,
              // reset the Type filter back to 'all' so they don't get an empty screen.
              if (!validTypes.has(currentFilters.type)) {
                currentFilters.type = 'all';
                typeBtns.forEach(b => b.classList.remove('active'));
                
                const allTypeBtn = document.querySelector('.filter-btn[data-filter-type="type"][data-value="all"]');
                if (allTypeBtn) allTypeBtn.classList.add('active');
              }
            }

            // Filter the actual products based on the combined active filters
            let visibleCount = 0;

            productCards.forEach(card => {
              const cardCategory = card.dataset.category;
              const cardType = card.dataset.type;

              const matchesCategory = currentFilters.category === 'all' || currentFilters.category === cardCategory;
              const matchesType = currentFilters.type === 'all' || currentFilters.type === cardType;

              if (matchesCategory && matchesType) {
                card.style.display = 'flex';
                visibleCount++;
              } else {
                card.style.display = 'none';
              }
            });

            // Show empty state message if 0 products match
            if (noProductsMsg) {
              noProductsMsg.style.display = visibleCount === 0 ? 'block' : 'none';
            }
          });
        });

        // --- 2. ADD TO CART LOGIC ---
        const addToCartBtns = document.querySelectorAll('.add-to-cart-btn');
        
        addToCartBtns.forEach(btn => {
          btn.addEventListener('click', (e) => {
            const target = e.currentTarget as HTMLButtonElement;
            const id = target.dataset.id!;
            const name = target.dataset.name!;
            const priceId = target.dataset.priceId!;
            const price = parseFloat(target.dataset.price!); 
            const image = target.dataset.image!;             

            // Call function from cart.ts
            addToCart({ id, name, priceId, price, image });

            // Visual feedback
            const originalText = target.innerText;
            target.innerText = "Added!";
            target.style.backgroundColor = "#2e7d32"; // Green success color
            
            setTimeout(() => {
              target.innerText = originalText;
              target.style.backgroundColor = ""; // Revert to CSS default
            }, 1500);
          });
        });
      }

      // Initialize on load
      initStore();
      
      // Re-initialize if using Astro View Transitions
      document.addEventListener('astro:after-swap', initStore);
    </script>
  </body>
</html>     `                                                                                   